# FastAPI / model data
HISTORICAL_DATA_PATH=./data/synthetic_prices.json
STABLECOIN_DECIMALS=18
CHAIN_ID=1990

# Signing and adapter integration
RPC_URL=https://rpc1mainnet.qie.digital
AI_ORACLE_PRIVATE_KEY=0x_replace_with_oracle_key
AI_ORACLE_ADDRESS=0x_replace_with_oracle_address
PRICE_ORACLE_ADAPTER_ADDRESS=0x_replace_with_adapter_address

# Nightly publisher
ENABLE_NIGHTLY_JOB=true
NIGHTLY_RUN_ON_START=false
ENABLE_ONCHAIN_PUBLISH=false
NONCE_FILE=./data/nonce_state.json
ORACLE_GAS_LIMIT=500000
MAX_FEE_GWEI=2
MAX_PRIORITY_FEE_GWEI=1
